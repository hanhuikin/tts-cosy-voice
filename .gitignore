# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 上游仓库 (部署时 git clone, 见 README)
CosyVoice/
index-tts/

# 独立虚拟环境 (IndexTTS / Qwen3-TTS worker)
.venv-qwen3/

# 离线 wheel 与 uv 备用缓存 (部署时生成, 体积较大)
.wheels/
.uv-cache-indextts/

# 模型权重 (部署时 scripts/download_models.py 下载, ~15GB 起)
models/

# 本机配置 (复制 .env.example 得到；只提交样例)
.env
!.env.example

# 运行时数据 (数据库 / 任务音频 / 播客成品 / 推流分片 / 大模型配置)
# 例外: 音色参考音频随仓库分发 (约 3MB), 元数据见 server/data/voices/manifest.json;
#       新克隆后执行 scripts/import_voices.py 导入。
#       预置背景音乐 (scripts/gen_preset_bgm.py 本地合成, 免版权) 同样随仓库分发。
server/data/*
!server/data/voices/
!server/data/bgm/
server_run.log

