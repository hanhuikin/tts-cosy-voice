# CosyVoice Server 配置样例：复制为 .env 后按需修改，重启服务生效。
# 优先级：PowerShell / 系统里已设置的环境变量 > .env；.env 已被 .gitignore 忽略。
# 不写某项即使用默认值；路径可用 / 或 \，含空格时请加双引号。

# ── 全局权重根目录（下面 7 个 *_DIR 未单独设置时的默认位置）──
# COSYVOICE_MODELS_DIR=D:/work/zcode/tts/models

# ── 7 个模型权重目录（对应「系统状态与设置」弹窗里的 7 行）──
# 默认依次为 <根目录>/Fun-CosyVoice3-0.5B、CosyVoice2-0.5B、IndexTTS-2、IndexTTS-2.5、
# Qwen3-TTS-12Hz-1.7B-CustomVoice、-Base、-VoiceDesign
# COSYVOICE3_DIR=D:/work/zcode/tts/models/Fun-CosyVoice3-0.5B
# COSYVOICE2_DIR=D:/work/zcode/tts/models/CosyVoice2-0.5B
# INDEXTTS2_DIR=D:/work/zcode/tts/models/IndexTTS-2
# INDEXTTS25_DIR=D:/work/zcode/tts/models/IndexTTS-2.5
# QWEN3TTS_DIR=D:/work/zcode/tts/models/Qwen3-TTS-12Hz-1.7B-CustomVoice
# QWEN3TTS_BASE_DIR=D:/work/zcode/tts/models/Qwen3-TTS-12Hz-1.7B-Base
# QWEN3TTS_DESIGN_DIR=D:/work/zcode/tts/models/Qwen3-TTS-12Hz-1.7B-VoiceDesign

# ── 独立运行环境（外部模型 worker）──
# INDEXTTS_REPO=D:/work/zcode/tts/index-tts
# INDEXTTS_PYTHON=D:/work/zcode/tts/index-tts/.venv/Scripts/python.exe
# QWEN3TTS_PYTHON=D:/work/zcode/tts/.venv-qwen3/Scripts/python.exe

# ── 可选推理参数 ──
# QWEN3TTS_DTYPE=bfloat16
# QWEN3TTS_DEVICE=cuda:0
# QWEN3TTS_ATTN=flash_attention_2
# INDEXTTS2_FP16=0
# INDEXTTS25_BF16=1
# COSYVOICE_DEFAULT_MODEL=cosyvoice3
